{
    "name": "lightstep/tracer",
    "description": "LightStep instrumentation API",
    "license": "MIT",
    "require": {
        "ruafozy/mersenne-twister": "^1.3 || ^2.0",
        "google/protobuf": ">=3.6.1",
        "ext-bcmath": "*",
        "psr/log": "^1.0 || ^2 || ^3"
    },
    "require-dev": {
        "ergebnis/phpunit-slow-test-detector": "^2.6",
        "phpunit/phpunit": "~9"
    },
    "autoload": {
        "psr-4": {
            "LightStepBase\\": "lib"
        },
        "files": [
            "lib/LightStep.php"
        ]
    },
    "version": "1.1.2",
    "abandoned": "open-telemetry/opentelemetry",
    "config": {
        "sort-packages": true
    }
}
